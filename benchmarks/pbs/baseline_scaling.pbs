#!/bin/bash
#PBS -N bl_scaling
#PBS -A NAML0001
#PBS -q main
#PBS -l select=1:ncpus=128:mpiprocs=1
#PBS -l walltime=01:00:00
#PBS -j oe
# Scaling reference: ORIGINAL inference, f00-f18 (19 files), script's own multiprocessing.Pool.
# Usage: qsub -v NPROCS="4 8" benchmarks/pbs/baseline_scaling.pbs
set -uo pipefail
export PTYPE_FAST=/glade/work/dgagne/ptype_fast
export REPO=$PTYPE_FAST/ptype-physical
export BL=/glade/derecho/scratch/dgagne/ptype_fast/baseline
export KERAS_BACKEND=torch PYTHONPATH=$REPO
export NUMBA_CACHE_DIR=$BL/numba_cache/${PBS_JOBID:-x}; mkdir -p $NUMBA_CACHE_DIR
source $PTYPE_FAST/venv/bin/activate
cd $REPO
echo "host=$(hostname) job=${PBS_JOBID:-none} commit=$(git rev-parse --short HEAD) date=$(date -u +%FT%TZ)"
CFG=config/inference_baseline_20240909.yml
for N in ${NPROCS:-1}; do
    RUN=$BL/runs/scaling_n$N; rm -rf $RUN; mkdir -p $RUN
    ( while true; do echo "$(date +%s) $(free -m | awk 'NR==2{print $3}')" >> $RUN/node_mem_used_mb.txt; sleep 5; done ) &
    SAMP=$!
    echo "=== n_procs=$N ==="
    /usr/bin/time -v python benchmarks/baseline_run.py -c $CFG --out-dir $RUN --fxx-start 0 --fxx-end 18 --n-procs $N
    echo "exit=$?"
    kill $SAMP
    ls $RUN/out/hrrr/*/*/ 2>/dev/null | wc -l
done
